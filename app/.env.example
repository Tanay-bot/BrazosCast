# Copy to `.env` and fill in to enable address geocoding.
# Optional: without it the app still runs — type a road name or click the map instead.
#
# Get a public token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Copy to `.env.local` and fill in to turn on the Ask panel (app/api/ask.ts).
# Server-side only: read by the Vercel function, never inlined into the browser bundle.
# Never rename it VITE_* — Vite compiles those into the public JavaScript.
# Without it the app still works; the Ask panel says it is unavailable.
GEMINI_API_KEY=
