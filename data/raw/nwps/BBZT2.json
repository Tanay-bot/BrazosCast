    "impacts": [
      {
        "stage": 66,
        "statement": "Major lowland flooding begins with backwater flooding up the Little Brazos River as far as FM 1687. Mount Zion Church near the left downstream bank of the Brazos River is threatened. In Burleson County, signficant backwater flooding up Cedar, Copper, and Dead Creeks occurs."
      },
      {
        "stage": 60,
        "statement": "Moderate lowland flooding begins with widespread inundation of the left downstream floodplain. "
      },
      {
        "stage": 52,
        "statement": "Minor lowland flooding begins as farm land along the river becomes inundated."
      },
      {
        "stage": 32,
        "statement": "Significant backwater flooding up the Little Brazos River occurs."
      },
      {
        "stage": 21,
        "statement": "Backwater flooding up the Little Brazos River begins."
      }
    ]
