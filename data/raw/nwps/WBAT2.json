    "impacts": [
      {
        "stage": 29,
        "statement": "Major flooding continues along the river. Significant residential flooding in the Honey Lane neighborhood and nearby RV park south of Waco continues. Significant flooding is also expected at the apartment complex west of downtown Waco on MLK Jr. Blvd., and the neighborhood at Faulkner Lane and MLK Jr. Blvd. begins to flood as well. Multiple parking lots near McLane Stadium have several feet of floodwater covering them."
      },
      {
        "stage": 27,
        "statement": "Major flooding along the river is expected. Significant residential flooding in the Honey Lane neighborhood and nearby RV park south of Waco continues. Floodwaters will begin to impact an apartment complex west of downtown Waco along MLK Blvd. as well. Several parking lots near McLane Stadium will also flood."
      },
      {
        "stage": 25,
        "statement": "Moderate flooding continues along the river. Significant flooding occurs in the Honey Lane neighborhood and nearby RV park south of Waco, as well as along the riverwalk in downtown Waco."
      },
      {
        "stage": 22,
        "statement": "Moderate flooding along the river is expected. Flooding will begin in the Honey Lane neighborhood south of the gage. Trails along the riverwalk in downtown Waco will experience significant flooding."
      },
      {
        "stage": 19,
        "statement": "Minor flooding along the river is expected. Trails along the riverwalk in downtown Waco will begin to flood."
      }
    ]
